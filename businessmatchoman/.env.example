############################################################
# Local development environment variables (example)
# Copy this file to .env.local and fill values.
# .env.local is git-ignored.
############################################################

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Auth
JWT_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=
VERIFIED_SENDER_EMAIL=

# Optional: Database (Postgres). When set, server will attempt to connect
# and run migrations at startup. Leave unset to use in-memory storage.
DATABASE_URL=
DB_SSL=true
DB_POOL_MAX=3
DB_STATEMENT_TIMEOUT=5000

# Optional: Twilio (WhatsApp/SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional: HuggingFace (translations)
HUGGINGFACE_API_KEY=
