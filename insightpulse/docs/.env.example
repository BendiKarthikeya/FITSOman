## InsightPulse environment variables

# Backend server port (default: 5002)
# Frontend runs on 5001, backend on 5002
PORT=5002

# PostgreSQL database connection string
# Example (Neon): postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_Mqw8dEVXyC3P@ep-icy-rice-afrqumwc.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require

# Secret for signing JWTs (optional)
# If not set, the server will generate a random secret at startup.
JWT_SECRET=

# Server port (optional; defaults to 5000)
PORT=5000

# Node environment (set automatically in scripts/commands)
# NODE_ENV=development

# Optional: Perplexity API key (if using AI features)
# PERPLEXITY_API_KEY=

########################################
# Caspio Integration (REST v2 via OAuth)
########################################

# Enable Caspio-backed storage for surveys and responses
CASPIO_ENABLED=true

# Base URL of your Caspio account (no trailing slash)
CASPIO_BASE_URL=https://d3dcb751.caspio.com

# OAuth2 Client Credentials for a Caspio API Profile with access to the tables below.
CASPIO_CLIENT_ID=ec5cce4c24324d1525f0ff7a1c0e2e25218a94dba81f847319
CASPIO_CLIENT_SECRET=65fdeb6ccde945318ee3d604a581d086081174266993bc1d6c

# Table names in Caspio (adjust if your tables differ)
CASPIO_TABLE_SURVEYS=surveys
CASPIO_TABLE_QUESTIONS=questions
CASPIO_TABLE_RESPONSES=responses

# Column used for ordering questions in Caspio (default: order). Your schema uses question_order
CASPIO_QUESTIONS_ORDER_COLUMN=question_order

# Enable verbose logging for Caspio requests (optional)
CASPIO_DEBUG=false

# Allow self-signed certs for Caspio (DEV ONLY)
# If your network performs SSL inspection, enable this to bypass TLS verification
# Do NOT use in production.
CASPIO_TLS_INSECURE=false

########################################
# Vapi Voice Agent (Voice surveys)
########################################

# Private API key (server → Vapi REST). REQUIRED for backend calls
# Get from Vapi dashboard → API Keys
VAPI_PRIVATE_API_KEY=db77aa21-0a44-40f0-9685-595ce27cd353

# Public API key (optional; only needed if you later call Vapi SDKs
# directly from the browser for embedding widgets or client-side features)
VAPI_PUBLIC_API_KEY=e9fc51f9-129b-483e-b8af-7074f3e31d4c

# Agent used to run calls (Required). Find the Agent ID in Vapi dashboard
VAPI_AGENT_ID=060de705-0562-4ae5-bb8f-14466f824902

# Base URL for Vapi API (defaults to official SaaS if unset)
VAPI_BASE_URL=https://api.vapi.ai

# Webhook secret (optional but recommended). If set, we verify signatures
VOICE_WEBHOOK_SECRET=

# Webhook path served by our backend (do not expose publicly in code)
# Example: /api/voice/webhook
VOICE_WEBHOOK_PATH=/api/voice/webhook

# If your Vapi tenant requires Twilio phone config at call time, set these:
# The Twilio sending phone number (E.164), and account SID used by Vapi to originate the call
VAPI_TWILIO_PHONE=
VAPI_TWILIO_ACCOUNT_SID=
\n# Or reference a Vapi Phone Number by ID (visible in the Vapi dashboard next to the number)
VAPI_PHONE_NUMBER_ID=002b1a27-3db4-4de4-b8f4-04da67f295a7
